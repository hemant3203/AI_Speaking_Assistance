# Copy to .env and fill in the values marked "required". Never commit .env.
APP_ENV=production
LOG_LEVEL=INFO

# Gemini: key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_ANALYSIS_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# gemini = real coach. mock = no key needed, for tests and demos only.
LIVE_PROVIDER=gemini

# The one admin account: free shop items and no daily limit. Leave empty to have no admin.
# It is created at startup. To change the password, edit it here and restart.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Auth. Required, at least 32 characters:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7
# Set to true when serving over HTTPS.
COOKIE_SECURE=false

# Network. 127.0.0.1 keeps the app on this computer only.
BIND_ADDRESS=127.0.0.1
ALLOWED_ORIGINS=http://localhost:1201,http://127.0.0.1:1201

# Cost guards, because every user shares one Gemini key.
DAILY_LIVE_SECONDS_PER_USER=1800
MAX_CONCURRENT_LIVE_SESSIONS=5

# Database. Required. Use letters and digits only in the password, and repeat it in DATABASE_URL:
#   python -c "import secrets;print(secrets.token_hex(24))"
POSTGRES_USER=spotlight
POSTGRES_PASSWORD=
POSTGRES_DB=spotlight
DATABASE_URL=postgresql+psycopg://spotlight:YOUR_PASSWORD@db:5432/spotlight
